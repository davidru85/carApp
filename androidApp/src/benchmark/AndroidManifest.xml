<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- E4-03 (D-252): Macrobenchmark reads startup and frame traces through the shell. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!--
          E4-03 (D-254): the benchmark-only seeding entry point. Exported only in this non-shipping
          variant, because the shell that starts it cannot start a non-exported activity.
        -->
        <activity
            android:name=".BenchmarkSeedActivity"
            android:exported="true" />
    </application>

</manifest>
