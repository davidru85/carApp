# ktlint configuration. E0-05 requires ktlint_official and forbids baseline suppression files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
# The project uses trailing commas; ktlint_official already enforces them.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composable functions are PascalCase by Compose convention, which ktlint's function-naming rule
# would otherwise reject.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Test function names are full English sentences on purpose: they are the specification a reviewer
# reads, so the length rule does not apply to them.
ktlint_ignore_back_ticked_identifier = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
