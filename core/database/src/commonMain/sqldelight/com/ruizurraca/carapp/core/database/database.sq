selectAllVehicles:
SELECT *
FROM vehicle
WHERE deleted = 0
ORDER BY nameFold ASC, id ASC;

selectVehicleById:
SELECT *
FROM vehicle
WHERE id = :id;

selectFuelEntryById:
SELECT *
FROM fuel_entry
WHERE id = :id;

nextLocalMutationSequence {
  UPDATE local_sequence
  SET next = next + 1
  WHERE id = 0;

  SELECT next
  FROM local_sequence
  WHERE id = 0;
}

coalesceOutbox:
INSERT INTO outbox (entityType, entityId, payload, localRevision)
VALUES (:entityType, :entityId, :payload, :localRevision)
ON CONFLICT(entityType, entityId) DO UPDATE SET
  payload = excluded.payload,
  localRevision = excluded.localRevision,
  attemptCount = 0,
  nextAttemptAt = 0,
  lastError = NULL,
  lastErrorCode = NULL;
