selectSettings:
SELECT currency, distanceUnit, volumeUnit, analyticsEnabled
FROM user_settings
WHERE id = 0;

upsertSettings:
INSERT INTO user_settings(id, currency, distanceUnit, volumeUnit, analyticsEnabled)
VALUES (0, :currency, :distanceUnit, :volumeUnit, :analyticsEnabled)
ON CONFLICT(id) DO UPDATE SET
  currency = excluded.currency,
  distanceUnit = excluded.distanceUnit,
  volumeUnit = excluded.volumeUnit,
  analyticsEnabled = excluded.analyticsEnabled;

deleteSettings:
DELETE FROM user_settings
WHERE id = 0;

selectAllVehicles:
SELECT *
FROM vehicle
WHERE deleted = 0
ORDER BY nameFold ASC, id ASC;

selectVehiclesByOwner:
SELECT *
FROM vehicle
WHERE ownerId = :ownerId AND (:includeDeleted = 1 OR deleted = 0)
ORDER BY nameFold ASC, id ASC;

selectVehicleById:
SELECT *
FROM vehicle
WHERE id = :id;

selectVehicleByOwnerAndId:
SELECT *
FROM vehicle
WHERE ownerId = :ownerId AND id = :id;

selectFuelEntryById:
SELECT *
FROM fuel_entry
WHERE id = :id;

selectFuelEntryByOwnerAndId:
SELECT *
FROM fuel_entry
WHERE ownerId = :ownerId AND id = :id;

selectFuelEntriesForList:
SELECT fuel_entry.*
FROM fuel_entry
WHERE fuel_entry.id IN (
  SELECT candidate.id
  FROM fuel_entry AS candidate
  INNER JOIN vehicle
    ON vehicle.id = candidate.vehicleId
    AND vehicle.ownerId = :ownerId
  WHERE candidate.ownerId = :ownerId
    AND candidate.vehicleId = :vehicleId
    AND (:includeDeleted = 1 OR candidate.deleted = 0)
  ORDER BY candidate.date DESC, candidate.createdAt DESC, candidate.id DESC
  LIMIT :rowLimit
)
ORDER BY date ASC, createdAt ASC, id ASC;

selectFuelEntriesForConsumption:
SELECT fuel_entry.*
FROM fuel_entry
WHERE fuel_entry.id IN (
  SELECT candidate.id
  FROM fuel_entry AS candidate
  INNER JOIN vehicle
    ON vehicle.id = candidate.vehicleId
    AND vehicle.ownerId = :ownerId
  WHERE candidate.ownerId = :ownerId
    AND candidate.vehicleId = :vehicleId
    AND candidate.deleted = 0
  ORDER BY candidate.odometerKm DESC, candidate.date DESC, candidate.id DESC
  LIMIT :rowLimit
)
ORDER BY odometerKm ASC, date ASC, id ASC;

selectPreviousActiveFuelEntry:
SELECT *
FROM fuel_entry
WHERE vehicleId = :vehicleId
  AND deleted = 0
  AND id != COALESCE(:excludedId, '')
  AND (
    date < :date
    OR (date = :date AND createdAt < :createdAt)
    OR (date = :date AND createdAt = :createdAt AND id < :targetId)
  )
ORDER BY date DESC, createdAt DESC, id DESC
LIMIT 1;

selectVehiclesForAdoption:
SELECT *
FROM vehicle
WHERE ownerId = :ownerId
ORDER BY localMutationSeq ASC, id ASC;

selectFuelEntriesForAdoption:
SELECT *
FROM fuel_entry
WHERE ownerId = :ownerId
ORDER BY localMutationSeq ASC, id ASC;

adoptVehicleRow:
UPDATE vehicle
SET ownerId = :newOwnerId,
  localRevision = localRevision + 1,
  syncState = CASE WHEN syncState = 'SYNCED' THEN 'SYNCED' ELSE 'PENDING' END
WHERE id = :id;

adoptFuelEntryRow:
UPDATE fuel_entry
SET ownerId = :newOwnerId,
  localRevision = localRevision + 1,
  syncState = CASE WHEN syncState = 'SYNCED' THEN 'SYNCED' ELSE 'PENDING' END
WHERE id = :id;

countRowsOwnedBy:
SELECT (SELECT COUNT(*) FROM vehicle WHERE ownerId = :ownerId)
     + (SELECT COUNT(*) FROM fuel_entry WHERE ownerId = :ownerId);

selectOutboxByEntity:
SELECT *
FROM outbox
WHERE entityType = :entityType AND entityId = :entityId;

selectActiveFuelEntriesByVehicle:
SELECT *
FROM fuel_entry
WHERE vehicleId = :vehicleId AND deleted = 0
ORDER BY date ASC, createdAt ASC, id ASC;

countActiveFuelEntriesByVehicle:
SELECT COUNT(*)
FROM fuel_entry
WHERE vehicleId = :vehicleId AND deleted = 0;

insertVehicleRow:
INSERT INTO vehicle(
  id, ownerId, name, nameFold, initialOdometerKm, currentOdometerKm, brand, model, fuelType,
  createdAt, updatedAt, serverUpdatedAt, deleted, deletedAt, syncState, localRevision,
  localMutationSeq, schemaVersion
)
VALUES (
  :id, :ownerId, :name, :nameFold, :initialOdometerKm, :currentOdometerKm, :brand, :model,
  :fuelType, :createdAt, :updatedAt, :serverUpdatedAt, :deleted, :deletedAt, :syncState,
  :localRevision, :localMutationSeq, :schemaVersion
);

updateVehicleRow:
UPDATE vehicle
SET ownerId = :ownerId,
  name = :name,
  nameFold = :nameFold,
  initialOdometerKm = :initialOdometerKm,
  brand = :brand,
  model = :model,
  fuelType = :fuelType,
  updatedAt = :updatedAt,
  syncState = 'PENDING',
  localRevision = :localRevision,
  localMutationSeq = :localMutationSeq
WHERE id = :id;

tombstoneVehicleRow:
UPDATE vehicle
SET ownerId = :ownerId,
  updatedAt = :updatedAt,
  deleted = 1,
  deletedAt = :deletedAt,
  syncState = 'PENDING',
  localRevision = :localRevision,
  localMutationSeq = :localMutationSeq
WHERE id = :id;

upsertRemoteVehicleRow:
INSERT INTO vehicle(
  id, ownerId, name, nameFold, initialOdometerKm, currentOdometerKm, brand, model, fuelType,
  createdAt, updatedAt, serverUpdatedAt, deleted, deletedAt, syncState, localRevision,
  localMutationSeq, schemaVersion
)
VALUES (
  :id, :ownerId, :name, :nameFold, :initialOdometerKm, :initialOdometerKm, :brand, :model,
  :fuelType, :createdAt, :updatedAt, :serverUpdatedAt, :deleted, :deletedAt, 'SYNCED', 0, 0,
  :schemaVersion
)
ON CONFLICT(id) DO UPDATE SET
  ownerId = excluded.ownerId,
  name = excluded.name,
  nameFold = excluded.nameFold,
  initialOdometerKm = excluded.initialOdometerKm,
  brand = excluded.brand,
  model = excluded.model,
  fuelType = excluded.fuelType,
  createdAt = excluded.createdAt,
  updatedAt = excluded.updatedAt,
  serverUpdatedAt = excluded.serverUpdatedAt,
  deleted = excluded.deleted,
  deletedAt = excluded.deletedAt,
  syncState = 'SYNCED',
  schemaVersion = excluded.schemaVersion
WHERE NOT EXISTS (
  SELECT 1
  FROM outbox
  WHERE entityType = 'VEHICLE' AND entityId = excluded.id
);

insertFuelEntryRow:
INSERT INTO fuel_entry(
  id, ownerId, vehicleId, date, odometerKm, litersScaled, pricePerLiterScaled,
  totalCostMinor, currency, isFullTank, hasMissedEntries, odometerInconsistent,
  notes, createdAt, updatedAt, serverUpdatedAt, deleted, deletedAt, syncState,
  localRevision, localMutationSeq, schemaVersion
)
VALUES (
  :id, :ownerId, :vehicleId, :date, :odometerKm, :litersScaled, :pricePerLiterScaled,
  :totalCostMinor, :currency, :isFullTank, :hasMissedEntries, :odometerInconsistent,
  :notes, :createdAt, :updatedAt, :serverUpdatedAt, :deleted, :deletedAt, :syncState,
  :localRevision, :localMutationSeq, :schemaVersion
);

updateFuelEntryRow:
UPDATE fuel_entry
SET id = :id,
  ownerId = :ownerId,
  vehicleId = :vehicleId,
  date = :date,
  odometerKm = :odometerKm,
  litersScaled = :litersScaled,
  pricePerLiterScaled = :pricePerLiterScaled,
  totalCostMinor = :totalCostMinor,
  currency = :currency,
  isFullTank = :isFullTank,
  hasMissedEntries = :hasMissedEntries,
  odometerInconsistent = :odometerInconsistent,
  notes = :notes,
  createdAt = :createdAt,
  updatedAt = :updatedAt,
  serverUpdatedAt = :serverUpdatedAt,
  deleted = :deleted,
  deletedAt = :deletedAt,
  syncState = :syncState,
  localRevision = :localRevision,
  localMutationSeq = :localMutationSeq,
  schemaVersion = :schemaVersion
WHERE id = :existingId;

tombstoneFuelEntryRow:
UPDATE fuel_entry
SET updatedAt = :updatedAt,
  deleted = 1,
  deletedAt = :deletedAt,
  syncState = :syncState,
  localRevision = :localRevision,
  localMutationSeq = :localMutationSeq
WHERE id = :id;

tombstoneFuelEntryForVehicleDelete:
UPDATE fuel_entry
SET ownerId = :ownerId,
  updatedAt = :updatedAt,
  deleted = 1,
  deletedAt = :deletedAt,
  syncState = 'PENDING',
  localRevision = :localRevision,
  localMutationSeq = :localMutationSeq
WHERE id = :id;

selectNextActiveFuelEntry:
SELECT *
FROM fuel_entry
WHERE vehicleId = :vehicleId
  AND deleted = 0
  AND (
    date > :date
    OR (date = :date AND createdAt > :createdAt)
    OR (date = :date AND createdAt = :createdAt AND id > :id)
  )
ORDER BY date ASC, createdAt ASC, id ASC
LIMIT 1;

recomputeFuelEntryOdometerInconsistent:
UPDATE fuel_entry
SET odometerInconsistent = COALESCE(
  (
    odometerKm <= (
      SELECT previous.odometerKm
      FROM fuel_entry AS previous
      WHERE previous.vehicleId = fuel_entry.vehicleId
        AND previous.deleted = 0
        AND (
          previous.date < fuel_entry.date
          OR (previous.date = fuel_entry.date AND previous.createdAt < fuel_entry.createdAt)
          OR (
            previous.date = fuel_entry.date
            AND previous.createdAt = fuel_entry.createdAt
            AND previous.id < fuel_entry.id
          )
        )
      ORDER BY previous.date DESC, previous.createdAt DESC, previous.id DESC
      LIMIT 1
    )
    OR odometerKm < (
      SELECT vehicle.initialOdometerKm
      FROM vehicle
      WHERE vehicle.id = fuel_entry.vehicleId
    )
  ),
  0
)
WHERE id = :id AND deleted = 0;

recomputeVehicleCurrentOdometer:
UPDATE vehicle
SET currentOdometerKm = MAX(
  initialOdometerKm,
  COALESCE(
    (
      SELECT MAX(fuel_entry.odometerKm)
      FROM fuel_entry
      WHERE fuel_entry.vehicleId = vehicle.id AND fuel_entry.deleted = 0
    ),
    initialOdometerKm
  )
)
WHERE id = :vehicleId;

nextLocalMutationSequence {
  UPDATE local_sequence
  SET next = next + 1
  WHERE id = 0;

  SELECT next
  FROM local_sequence
  WHERE id = 0;
}

coalesceOutbox:
INSERT INTO outbox (entityType, entityId, payload, localRevision)
VALUES (:entityType, :entityId, :payload, :localRevision)
ON CONFLICT(entityType, entityId) DO UPDATE SET
  payload = excluded.payload,
  localRevision = excluded.localRevision,
  attemptCount = 0,
  nextAttemptAt = 0,
  lastError = NULL,
  lastErrorCode = NULL;

confirmVehiclePush:
UPDATE vehicle
SET serverUpdatedAt = :serverUpdatedAt,
  syncState = CASE
    WHEN localRevision = :pushedLocalRevision THEN 'SYNCED'
    ELSE syncState
  END
WHERE id = :entityId;

deleteConfirmedVehicleOutbox:
DELETE FROM outbox
WHERE entityType = 'VEHICLE'
  AND entityId = :entityId
  AND localRevision = :pushedLocalRevision;

selectAnonymousReminder:
SELECT anonymousUid, lastShownIndex
FROM anonymous_reminder
WHERE id = 0;

upsertAnonymousReminder:
INSERT INTO anonymous_reminder(id, anonymousUid, lastShownIndex)
VALUES (0, :anonymousUid, :lastShownIndex)
ON CONFLICT(id) DO UPDATE SET
  anonymousUid = excluded.anonymousUid,
  lastShownIndex = excluded.lastShownIndex;

deleteAnonymousReminder:
DELETE FROM anonymous_reminder
WHERE id = 0;

selectAccountConversionOperation:
SELECT anonymousUid, permanentUid, cleanupTicket, phase
FROM account_conversion_operation
WHERE id = 0;

selectAccountConversionSnapshots:
SELECT entityType, entityId, payload, localRevision, localMutationSeq, remoteServerUpdatedAt
FROM account_conversion_snapshot
ORDER BY CASE entityType WHEN 'VEHICLE' THEN 0 ELSE 1 END, localMutationSeq ASC, entityId ASC;

insertAccountConversionOperation:
INSERT INTO account_conversion_operation(id, anonymousUid, permanentUid, cleanupTicket, phase)
VALUES (0, :anonymousUid, NULL, NULL, 'SNAPSHOT_CAPTURED');

insertAccountConversionSnapshot:
INSERT INTO account_conversion_snapshot(
  entityType, entityId, payload, localRevision, localMutationSeq, remoteServerUpdatedAt
)
VALUES (:entityType, :entityId, :payload, :localRevision, :localMutationSeq, NULL);

saveAccountConversionCleanupTicket:
UPDATE account_conversion_operation
SET cleanupTicket = :cleanupTicket
WHERE id = 0;

saveAccountConversionPermanentUid:
UPDATE account_conversion_operation
SET permanentUid = :permanentUid,
  phase = 'SESSION_SWITCHED'
WHERE id = 0;

saveAccountConversionRemoteAck:
UPDATE account_conversion_snapshot
SET remoteServerUpdatedAt = :remoteServerUpdatedAt
WHERE entityType = :entityType AND entityId = :entityId;

setAccountConversionPhase:
UPDATE account_conversion_operation
SET phase = :phase
WHERE id = 0;

deleteAccountConversionSnapshots:
DELETE FROM account_conversion_snapshot;

deleteAccountConversionOperation:
DELETE FROM account_conversion_operation
WHERE id = 0;

deleteAllFuelEntriesForAccountConversion:
DELETE FROM fuel_entry;

deleteAllVehiclesForAccountConversion:
DELETE FROM vehicle;

deleteAllOutboxForAccountConversion:
DELETE FROM outbox;

deleteAllSyncCursorsForAccountConversion:
DELETE FROM sync_cursor;

deleteAllQuarantineForAccountConversion:
DELETE FROM quarantine;

countOutboxRows:
SELECT COUNT(*)
FROM outbox;

deleteAllFuelEntries:
DELETE FROM fuel_entry;

deleteAllVehicles:
DELETE FROM vehicle;

deleteAllOutbox:
DELETE FROM outbox;

deleteAllSyncCursors:
DELETE FROM sync_cursor;

deleteAllQuarantine:
DELETE FROM quarantine;

-- `local_sequence` is a single control row, not owner data, so the clear restores its canonical
-- initial state instead of deleting it. `docs/TECHNICAL_PLAN.md §6` defines that state as
-- (id = 0, next = 1), which is what a freshly created database holds.
resetLocalSequence:
UPDATE local_sequence
SET next = 1
WHERE id = 0;

restoreLocalSequenceRow:
INSERT OR IGNORE INTO local_sequence(id, next)
VALUES (0, 1);

selectLocalSequenceNext:
SELECT next
FROM local_sequence
WHERE id = 0;
